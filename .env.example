# Copy to .env.local for development. Never commit real values.
# Preview and production values live in Vercel (Project Settings > Environment Variables).
# Setup steps and the per-environment value table: _ai_context/INFRA.md
#
# Names from PRD section 15.4 come first. Entries marked "(extra)" are not in that list but are
# required by another PRD section, named in brackets.

# ---------------------------------------------------------------------------
# Database: MongoDB on Atlas, Canada (Central) [DATA-08, NFR-04]
# Transactions need a replica set: an Atlas cluster is one. Local development:
# `npm run db:local` starts a throwaway one that matches the default below. Preview and
# production: copy both strings from Atlas ("Connect" > "Drivers"), with the database name
# (boustan) between the host and the "?":
#   MONGODB_URI             the app's user, which holds only the least-privilege role
#                           (db/roles.ts).
#   MONGODB_URI_MIGRATIONS  an admin user, for migrations, seeds and `npm run campaign`.
# ---------------------------------------------------------------------------
MONGODB_URI=mongodb://127.0.0.1:27019/boustan?replicaSet=rs0&directConnection=true
# (extra) Migrations, seeds and `npm run campaign`. Blank: MONGODB_URI is used.
MONGODB_URI_MIGRATIONS=
# (extra) Connections per server instance (default 5). Atlas caps connections per cluster
# tier, so keep this low when many instances run at once.
MONGODB_POOL_MAX=

# ---------------------------------------------------------------------------
# Signing [SEC-01, SEC-04, DATA-07]
# Generate with: npm run gen:secret   (use a different value in each environment)
# Signs the run, save and admin tokens (sign-in links and sessions). Changing it voids every
# run and save token in flight and signs every admin out, so rotate only with a reason.
# ---------------------------------------------------------------------------
RUN_TOKEN_SECRET=

# ---------------------------------------------------------------------------
# Bot check: Cloudflare Turnstile [SEC-05]
# These are Cloudflare's published dummy keys (invisible widget, always passes). Use real keys
# in production only.
# ---------------------------------------------------------------------------
TURNSTILE_SECRET=1x0000000000000000000000000000000AA
# (extra) Public site key for the widget.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000BB

# ---------------------------------------------------------------------------
# Email: Resend, used only for admin sign-in links [ADM-01]
# The game sends players no email. Boustan contacts the winners itself, from the admin
# Winners panel.
# ---------------------------------------------------------------------------
EMAIL_API_KEY=
# Must be on a domain verified in Resend. jeu.boustan.ca is a placeholder [Boustan].
EMAIL_FROM="Boustan <promo@jeu.boustan.ca>"
# (extra) Address that receives replies to the sign-in emails.
EMAIL_REPLY_TO=
# (extra) 1 = never send to real addresses (dev and preview): with an API key, mail goes to
# Resend's delivered@resend.dev; without one, it is written to ./.emails/ instead. 0 only in
# production.
EMAIL_SANDBOX=1

# ---------------------------------------------------------------------------
# Embedding [EMB-05, EMB-06]
# Comma-separated origins allowed to embed the game and to send host commands, written as CSP
# frame-ancestors sources. The standalone URL always works.
# ---------------------------------------------------------------------------
ALLOWED_HOSTS=http://localhost:*,http://127.0.0.1:*

# ---------------------------------------------------------------------------
# Admin [ADM-01]
# Comma-separated emails allowed to sign in to /admin. Each gets a sign-in link by email and a
# 12-hour session; removing an address signs that person out at once.
# ---------------------------------------------------------------------------
ADMIN_EMAILS=
# (extra) 1 = show the sign-in link on the login page instead of relying on email. For local
# development and demos on a protected preview only. Never in production.
ADMIN_DEV_LINK=

# ---------------------------------------------------------------------------
# CRM [CRM-01 to CRM-07]
# ---------------------------------------------------------------------------
# none | webhook | hubspot
CRM_PROVIDER=none
# opted_in | all
CRM_SYNC_SCOPE=opted_in
CRM_WEBHOOK_URL=
# HMAC-SHA256 key for the signature header on outgoing webhook calls.
CRM_WEBHOOK_SECRET=
# HubSpot, only when CRM_PROVIDER=hubspot. Names are provisional until Boustan confirms the CRM.
HUBSPOT_PORTAL_ID=
HUBSPOT_FORM_GUID=
HUBSPOT_PRIVATE_APP_TOKEN=

# ---------------------------------------------------------------------------
# Rate limits: Upstash Redis, region ca-central-1 [SEC-06]
# ---------------------------------------------------------------------------
# Blank: an in-memory limiter per server instance (fine for dev; logs a warning in production).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# (extra) Override the defaults, as name=limit/seconds: runStart=60/3600, saveIp=5/3600,
# leaderboard=120/60, adminLogin=10/3600, events=600/3600.
RATE_LIMITS=

# ---------------------------------------------------------------------------
# Cron: Vercel sends "Authorization: Bearer <CRON_SECRET>" to /api/cron/* when this is set.
# Blank: the cron routes answer only outside production (call them by hand in dev).
# ---------------------------------------------------------------------------
CRON_SECRET=

# ---------------------------------------------------------------------------
# (extra) Error tracking: Sentry [NFR-08]
# Server-side only. There is no browser DSN on purpose: a client SDK would add bytes to the
# 250 KB budget [EMB-11] and a third-party call inside the iframe [NFR-07].
# ---------------------------------------------------------------------------
SENTRY_DSN=
# Build time only, for source maps.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# ---------------------------------------------------------------------------
# (extra) App
# Public base URL of this deployment, used for the admin sign-in link and for share links
# [ADM-01, GAME-16]. On Vercel, set it per environment.
# ---------------------------------------------------------------------------
APP_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# (extra) Game client [Stage 1]. NEXT_PUBLIC_* values are baked in at build time.
# ---------------------------------------------------------------------------
# live (real /api endpoints; needs the database) | mock (in-browser API with ?mock= scenarios,
# no database; the Playwright suite always uses it)
NEXT_PUBLIC_API_MODE=live
# utm_campaign on outbound links [EMB-09].
NEXT_PUBLIC_CAMPAIGN_ID=game-2026
# "Challenge a friend" link [GAME-16]. Blank: this deployment's standalone URL. src=share is added.
NEXT_PUBLIC_SHARE_URL=
# window.__stc test hooks: 1 or 0. Unset: on in dev and Vercel previews, off in production builds.
# End-to-end tests against a local production build set it to 1 (playwright.config.ts does).
STC_TEST_HOOKS=
