{
  "name": "boustan-save-the-chicken",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:db": "vitest run --project db",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:live": "playwright test -c playwright.live.config.ts",
    "record:runs": "playwright test -c playwright.record.config.ts",
    "check:i18n": "tsx scripts/check-i18n.ts",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run check:i18n",
    "db:local": "tsx scripts/db-local.ts",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "db:roles": "tsx scripts/db-roles.ts",
    "db:seed": "tsx scripts/db-seed.ts",
    "campaign": "tsx scripts/campaign.ts",
    "update:disposable": "tsx scripts/update-disposable.ts",
    "gen:secret": "node -e \"console.log(require('node:crypto').randomBytes(32).toString('base64url'))\""
  },
  "dependencies": {
    "@upstash/ratelimit": "^2.2.0",
    "@upstash/redis": "^1.39.0",
    "mongodb": "^7.7.0",
    "next": "16.3.8",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "resend": "^6.32.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.19.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "eslint-config-prettier": "^10.1.8",
    "mongodb-memory-server-core": "^11.3.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.3"
  }
}
